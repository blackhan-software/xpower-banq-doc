# VitePress build-time env vars (single source of truth — both local
# dev and CI read from here; `.github/workflows/gh-pages.yml` does
# not override). The VITE_ prefix is required to reach the client
# (non-VITE vars are build-time only and never reach client JS).

# Base URL of the Cloudflare Worker that proxies the Anthropic API
# for the "Ask AI" widget; unset disables the widget (read via
# `.vitepress/theme/constants.ts`):
VITE_AI_WORKER_URL=https://ai.xpowerbanq.com

# Target of the top-nav "App" link and the `<link rel="alternate"
# type="text/html">`; read at build via `loadEnv` in
# `.vitepress/config/{nav,head}.ts`:
BANQ_APP_URL=https://app.xpowerbanq.com

# Canonical hostname of this www-site; populates `sitemap.hostname`,
# per-page `<link rel="canonical">`, and `og:url`; read at build via
# `loadEnv` in `.vitepress/config/seo.ts`:
BANQ_WWW_URL=https://www.xpowerbanq.com

# Public URL of the whitepaper PDF; populates `<link rel="alternate"
# type="application/pdf">` (read at build in `.vitepress/config/head.ts`):
BANQ_PAPER_URL=https://ipfs.xpowerbanq.com/ipfs/QmUsLmdgKY9e8yU3Q4SoN2kA4j2R11FWdtyxm3rTrH68BP
